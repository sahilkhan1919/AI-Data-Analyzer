# Copy to .env for local development. Never commit actual deployment secrets.
FLASK_ENV=development
PORT=5001

# Local SQLite default. PostgreSQL URLs, including Neon URLs, use psycopg 3.
DATABASE_URI=sqlite:///csv_dashboard.db
# DATABASE_URI=postgresql+psycopg://user:password@host:5432/csv_dashboard

# Required in all environments. Generate once and persist securely; do not rotate
# on each startup. For example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Global cleanup is disabled unless a private scheduler/admin token is configured.
# DATASET_CLEANUP_TOKEN=

DATASET_EXPIRATION_HOURS=24
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Production should use HTTPS, SameSite=None for cross-site frontend hosting.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

MAX_UPLOAD_BYTES=10485760
UPLOAD_FOLDER=uploads
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Local filesystem is the default. Production uses a private Supabase Storage bucket.
STORAGE_BACKEND=local
# STORAGE_BACKEND=supabase
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<project-region>
# SUPABASE_S3_ACCESS_KEY_ID=<server-side-s3-access-key>
# SUPABASE_S3_SECRET_ACCESS_KEY=<server-side-s3-secret-key>
# SUPABASE_BUCKET_NAME=<private-bucket-name>

# Optional OpenAI-compatible explanation provider. Leave unset for deterministic
# local explanations; only calculated answer summaries are sent when configured.
# LLM_API_KEY=
# LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
